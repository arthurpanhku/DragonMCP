{
  "name": "dragon-mcp",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "DragonMCP - A Model Context Protocol (MCP) server for Hong Kong and cross-border open data",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "nodemon",
    "dev:stdio": "tsx src/stdio.ts",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^7.2.0",
    "@vercel/node": "^5.3.6",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
