# Server Configuration (HTTP transport only; stdio needs neither)
PORT=3000
NODE_ENV=development

# Hong Kong data sources (MTR, HK Observatory) need NO key — they work out of the box.

# Mainland China: Amap (Gaode) Web Service key.
# Only required for the amap_* tools and CN routing. Get one at https://lbs.amap.com/
AMAP_API_KEY=your_amap_api_key
